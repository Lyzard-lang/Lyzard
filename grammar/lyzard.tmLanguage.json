{
  "name": "LYZARD",
  "scopeName": "source.lyz",
  "fileTypes": ["lyz"],
  "foldingStartMarkers": ["\\{\\s*$", "/\\*"],
  "foldingStopMarkers": ["^\\s*\\}", "\\*/"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#char_literals" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.lyzard",
          "match": "--.*$"
        },
        {
          "name": "comment.block.lyzard",
          "begin": "/-",
          "end": "-/",
          "patterns": [
            { "include": "#comments" }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.lyzard",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.lyzard" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.lyzard" } },
          "patterns": [
            {
              "name": "constant.character.escape.lyzard",
              "match": "\\\\(?:[ntr\\\"'0]|u\\{[0-9a-fA-F]{1,6}\\})"
            }
          ]
        }
      ]
    },
    "char_literals": {
      "patterns": [
        {
          "name": "string.quoted.single.lyzard",
          "begin": "'",
          "end": "'",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.lyzard" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.lyzard" } },
          "patterns": [
            {
              "name": "constant.character.escape.lyzard",
              "match": "\\\\(?:[ntr\\\"'0]|u\\{[0-9a-fA-F]{1,6}\\})"
            },
            {
              "name": "invalid.illegal.char.lyzard",
              "match": "."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.lyzard",
          "match": "\\b0[xX][0-9a-fA-F][0-9a-fA-F_]*\\b"
        },
        {
          "name": "constant.numeric.binary.lyzard",
          "match": "\\b0[bB][01][01_]*\\b"
        },
        {
          "name": "constant.numeric.octal.lyzard",
          "match": "\\b0[oO][0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.float.lyzard",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9][0-9_]*)?\\b"
        },
        {
          "name": "constant.numeric.integer.lyzard",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lyzard",
          "match": "\\b(?:return|if|else|while|for|in|break|continue|loop|match|spawn|select)\\b"
        },
        {
          "name": "keyword.declaration.lyzard",
          "match": "\\b(?:let|mut|fn|struct|impl|enum|pub|import|module)\\b"
        },
        {
          "name": "keyword.other.null.lyzard",
          "match": "\\bnull\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.lyzard",
          "match": "\\b(?:int|float|bool|str|char|void)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.lyzard",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.lyzard",
          "match": "=>"
        },
        {
          "name": "keyword.operator.arrow.lyzard",
          "match": "->"
        },
        {
          "name": "keyword.operator.comparison.lyzard",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.lyzard",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.range.lyzard",
          "match": "\\.\\.=?"
        },
        {
          "name": "keyword.operator.optional.lyzard",
          "match": "\\?\\?"
        },
        {
          "name": "keyword.operator.error.lyzard",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.assignment.lyzard",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.lyzard",
          "match": "\\+|-|\\*|/|%"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.bracket.round.lyzard",
          "match": "[()]"
        },
        {
          "name": "punctuation.bracket.square.lyzard",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.bracket.curly.lyzard",
          "match": "[{}]"
        },
        {
          "name": "punctuation.separator.lyzard",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.accessor.lyzard",
          "match": "\\."
        },
        {
          "name": "punctuation.definition.hash.lyzard",
          "match": "#"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.lyzard",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
